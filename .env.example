# Optional when the API is hosted separately from the website.
VITE_BOOKING_API_URL=/api/book-date

# Telegram notifications (configure both values).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required for direct email delivery to ignas.judo@gmail.com.
# Set this secret in Vercel Project Settings > Environment Variables.
RESEND_API_KEY=
# The resend.dev sender only delivers to the Resend account owner's email.
# Use a verified domain sender if that account is not ignas.judo@gmail.com.
BOOKING_FROM_EMAIL="Mūsų pasimatymai <onboarding@resend.dev>"

# Only needed when the frontend and API use different domains.
BOOKING_ALLOWED_ORIGIN=
